--- a/vudc_tx.c
+++ b/vudc_tx.c
@@ -13,0 +14,17 @@
+#include <linux/moduleparam.h>
+#include <linux/atomic.h>
+
+/* Test-only scheduling control. Retain real completed native URBs until the
+ * importer disconnects. No USB/IP request or reply is manufactured. */
+static bool webmux_hold_replies;
+module_param_named(webmux_test_hold_replies, webmux_hold_replies, bool, 0600);
+static atomic_t webmux_held_replies = ATOMIC_INIT(0);
+static int webmux_held_get(char *buffer, const struct kernel_param *kp)
+{
+	(void)kp;
+	return sysfs_emit(buffer, "%d\n", atomic_read(&webmux_held_replies));
+}
+static const struct kernel_param_ops webmux_held_ops = {
+	.get = webmux_held_get,
+};
+module_param_cb(webmux_test_held_replies, &webmux_held_ops, NULL, 0400);
@@ -192,0 +210,4 @@
+		if (READ_ONCE(webmux_hold_replies)) {
+			spin_unlock_irqrestore(&udc->lock_tx, flags);
+			return total_size;
+		}
@@ -227,0 +249,6 @@
+		if (READ_ONCE(webmux_hold_replies)) {
+			wait_event_interruptible_timeout(udc->tx_waitq,
+				!READ_ONCE(webmux_hold_replies) || kthread_should_stop(),
+				msecs_to_jiffies(10));
+			continue;
+		}
@@ -284 +311,3 @@
-}
+	if (READ_ONCE(webmux_hold_replies))
+		atomic_inc(&webmux_held_replies);
+}
