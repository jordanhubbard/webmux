{
  "name": "webmux",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "https-proxy-agent": "^5.0.1"
  },
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build:helpers && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:helpers": "tsc --project tsconfig.helpers.json",
    "typecheck": "tsc --noEmit --project backend/tsconfig.json && tsc --noEmit --project frontend/tsconfig.json && tsc --project tsconfig.tools.json && tsc --noEmit --project tsconfig.helpers.json && tsc --project tsconfig.e2e.json",
    "test:contract": "npm run build --workspace=backend && node scripts/server-contract.mts",
    "test:contract:auth": "npm run test:contract",
    "test:e2e": "node scripts/run-playwright.mts",
    "test:e2e:go": "node scripts/run-playwright.mts --backend=go",
    "test:visual-parity": "node scripts/visual-parity.mts",
    "benchmark:server": "npm run build --workspace=backend && node scripts/benchmark-server.mts",
    "start": "npm run start --workspace=backend",
    "service:install": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 install",
    "service:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 uninstall",
    "service:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 start",
    "service:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 stop",
    "service:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 restart",
    "service:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 status",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "test:helpers": "npm run build:helpers && node --test scripts/helpers.test.mts ../scripts/release-metadata.test.mts",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend && npm run test:helpers"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
