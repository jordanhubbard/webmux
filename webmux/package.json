{
  "name": "webmux",
  "version": "1.3.13",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "https-proxy-agent": "^5.0.1"
  },
  "scripts": {
    "dev:backend": "npm run build && node scripts/native.mts start",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build:helpers && npm run build --workspace=frontend && node scripts/native.mts build",
    "build:helpers": "tsc --project tsconfig.helpers.json",
    "typecheck": "node scripts/check-typescript.mts",
    "test:contract": "node scripts/server-contract.mts",
    "test:e2e": "node scripts/run-playwright.mts",
    "test:e2e:go": "node scripts/run-playwright.mts",
    "benchmark:server": "node scripts/benchmark-server.mts",
    "start": "node scripts/native.mts start",
    "service:install": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 install",
    "service:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 uninstall",
    "service:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 start",
    "service:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 stop",
    "service:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 restart",
    "service:reconfigure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 reconfigure",
    "service:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File service/windows-service.ps1 status",
    "lint": "npm run lint:go && npm run lint --workspace=frontend",
    "lint:go": "cd server && go vet ./...",
    "test:helpers": "npm run build:helpers && node --test scripts/helpers.test.mts ../scripts/release-metadata.test.mts ../scripts/render-service.test.mts ../scripts/verify-native-artifacts.test.mts ../scripts/make-controls.test.mts",
    "test": "npm run test:go && npm run test --workspace=frontend && npm run test:helpers",
    "test:go": "cd server && go test ./...",
    "test:visual": "node scripts/visual-repeatability.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.12.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.5.12",
    "argon2": "^0.31.2",
    "jsonwebtoken": "^9.0.2",
    "js-yaml": "^4.1.0",
    "ws": "^8.18.0",
    "typescript": "^5.4.0"
  }
}
