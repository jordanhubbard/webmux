{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "argon2": ["./node_modules/argon2/argon2.d.ts"],
      "node-pty": ["./node_modules/node-pty/typings/node-pty.d.ts"]
    }
  },
  "include": ["scripts/**/*.mts", "../scripts/**/*.mts", "../tests/e2e/*.mts"]
}
