# WebMux environment variables
# Copy to .env and customize for your deployment.

# Optional external web/ and config.defaults/ override (otherwise embedded assets)
# WEBMUX_ROOT=/opt/webmux

# Override ports from app.yaml
# HTTP_PORT=8080
# HTTPS_PORT=8443

# JWT signing secret — MUST be set in production
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
