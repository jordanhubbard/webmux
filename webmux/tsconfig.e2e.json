{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@playwright/test": ["./node_modules/@playwright/test"] }
  },
  "include": ["playwright.config.ts", "../tests/e2e/**/*.ts"]
}
