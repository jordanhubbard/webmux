[Unit]
Description=WebMux SSH Terminal Multiplexer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="WEBMUX_ROOT=__WEBMUX_DIR__"
Environment="WEBMUX_HOME=__WEBMUX_HOME__"
Environment="PATH=__PATH__"
WorkingDirectory=__WEBMUX_DIR__
ExecStart=:/usr/bin/env -- "__WEBMUX_DIR__/bin/webmux"
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# Let the server close PTYs and flush transcripts before cgroup cleanup.
KillMode=mixed
TimeoutStopSec=30

StandardOutput=append:__WEBMUX_HOME__/logs/webmux.log
StandardError=append:__WEBMUX_HOME__/logs/webmux.log

[Install]
WantedBy=default.target
